# /var/lib/ploverai/app/pipeline/.env — read by the FastAPI systemd
# unit on service start. chmod 600, owned by the `ploverai` service
# user. NEVER commit a populated copy of this file.
#
# OPENROUTER_API_KEY — from https://openrouter.ai/keys. make a key for
# this server only and give it a credit limit there: it is the one cap
# that holds even if everything else fails.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# PLOVERAI_API_KEY — the key the API expects in X-API-Key. nginx adds
# it to every /api/ request (the __API_KEY__ placeholder in
# nginx.conf.template), so the browser never sees it. generate with:
#   openssl rand -hex 32
PLOVERAI_API_KEY=replace-with-32-byte-hex

# PLOVERAI_PUBLIC — 1 turns on public site mode: only the models in
# config.yaml's public: block, only ARAX, per-address and daily
# question limits, and no shared run history.
PLOVERAI_PUBLIC=1

# optional: PLOVERAI_CORS_ORIGINS — comma-separated list of origins
# allowed to call /api/*. blank disables CORS entirely. unset in
# production since nginx serves UI + API at the same origin.
# PLOVERAI_CORS_ORIGINS=
