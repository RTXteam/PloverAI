# PloverAI nginx vhost — copy to /etc/nginx/sites-available/ploverai,
# replace the three __PLACEHOLDERS__, then symlink into sites-enabled.
# certbot will edit this file in place to add the TLS block + the
# 80→443 redirect once you run `certbot --nginx -d __DOMAIN__`.
#
# placeholders:
#   __DOMAIN__   — the domain you pointed at this EC2 (e.g. ploverai.example.com)
#   __APP_DIR__  — where the cloned repo lives (e.g. /var/lib/ploverai/app)
#   __API_KEY__  — PLOVERAI_API_KEY from pipeline/.env. nginx adds it to
#                  every /api/ request, so the key never ships in the
#                  browser's JavaScript.
#
# the public site has no login. nginx is the first line against floods;
# the per-question rules (one at a time per address, N per hour, a daily
# cap, only the cheap model) are enforced behind it by the API's public
# mode (PLOVERAI_PUBLIC=1, numbers in pipeline/config.yaml).

# any /api/ request: 10 per minute per address, bursts of 20. enough for
# the UI (info, models, questions, one run) and for opening links.
limit_req_zone $binary_remote_addr zone=ploverai_api:10m rate=10r/m;

# asking a question (/api/v1/query and /api/v1/query/stream): 2 per
# minute per address, bursts of 3. the map leaves the key empty for
# every other path, and nginx does not limit an empty key.
map $request_uri $ploverai_question_key {
    ~^/api/v1/query  $binary_remote_addr;
    default          "";
}
limit_req_zone $ploverai_question_key zone=ploverai_question:10m rate=2r/m;

# open connections per address; a streamed answer holds one for up to
# ten minutes.
limit_conn_zone $binary_remote_addr zone=ploverai_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot will edit this server block to add the 80→443 redirect.
    # before that runs, this block also serves the ACME http-01
    # challenge from /.well-known/acme-challenge/ automatically.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    # TLS — populated by certbot. uncomment / leave for certbot to fill:
    # ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # no login on the public site. to close it to a lab again, create
    # /etc/nginx/.auth/ploverai with htpasswd and uncomment:
    # auth_basic           "PloverAI";
    # auth_basic_user_file /etc/nginx/.auth/ploverai;

    # security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options           "SAMEORIGIN"                          always;
    add_header X-Content-Type-Options    "nosniff"                             always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"     always;

    # body size cap — TRAPI queries are JSON, never large. 1 MB is
    # comfortable headroom; anything bigger is probably an attack
    # payload.
    client_max_body_size 1m;

    # /api/v1/* — proxy to the FastAPI service on localhost:8000.
    # SSE streaming endpoint needs proxy_buffering off + a long read
    # timeout so the live log stream isn't buffered or cut off.
    location /api/ {
        limit_req  zone=ploverai_api      burst=20 nodelay;
        limit_req  zone=ploverai_question burst=3  nodelay;
        limit_conn ploverai_conn 4;
        limit_req_status  429;
        limit_conn_status 429;

        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # replaces whatever the browser sent. the API trusts X-Real-IP
        # only because this proxy is its sole caller on 127.0.0.1.
        proxy_set_header   X-API-Key         "__API_KEY__";

        # SSE / streaming support
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # everything else — static export from Next.js build.
    # rsync'd into /var/www/ploverai/out/ during deploy.
    location / {
        root  /var/www/ploverai/out;
        try_files $uri $uri/ $uri.html /index.html;

        # cache static assets aggressively. Next.js fingerprints
        # filenames so a far-future cache is safe.
        location /_next/static/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # never cache the HTML shell — that's the entry point for the
        # whole client-side app + the place we read ?run=<id> from.
        location = /index.html {
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }
    }

    # static export emits trailingSlash URLs (next.config.ts:
    # trailingSlash: true) — make sure non-trailing requests get
    # redirected so deep-linked routes resolve.
    if ($request_uri ~* "^[^?]*[^/])$") {
        return 301 $scheme://$host$1/$is_args$args;
    }
}
